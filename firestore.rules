rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // IMPORTANT: replace the example allow-list with your actual staff UID/email policy.
    // Only the owner should be able to change staff permissions.
    match /shops/{shopId}/data/{docId} {
      allow read, write: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'OWNER_EMAIL_REPLACE_ME@example.com'
        ];
    }
  }
}
